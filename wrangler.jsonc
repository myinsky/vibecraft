{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibecraft-preview",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "APP_ENV": "preview",
    "STORAGE_PROVIDER": "r2",
    "DATABASE_PROVIDER": "hyperdrive",
    "DB_PORT": "4000",
    "DB_HOST": "gateway01.ap-northeast-1.prod.aws.tidbcloud.com",
    "DB_NAME": "vibecraft_preview"
  },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/manus-storage/*"]
  },
  // Direct MySQL vars remain available as an inactive fallback. Store DB_USER and
  // DB_PASSWORD with `wrangler secret put`; never commit their values.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "52fc752b92c24f60b50473f3a5c59c68"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "vibecraft-preview"
    }
  ]
}
