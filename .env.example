# ═══════════════════════════════════════════════════════════════════════════
# 워드크래커 블로그 (Wordcracker Blog) - 환경변수 설정
# ═══════════════════════════════════════════════════════════════════════════
# 
# 이 파일을 복사하여 .env.local 또는 .env 파일을 생성하고 실제 값으로 채워주세요.
# 프로덕션 배포 시에는 환경변수를 시스템 환경에 직접 설정하세요.

# ─────────────────────────────────────────────────────────────────────────
# 데이터베이스 설정
# ─────────────────────────────────────────────────────────────────────────
# MySQL/TiDB 연결 문자열
# 형식: mysql://사용자명:비밀번호@호스트:포트/데이터베이스명
DATABASE_URL=mysql://user:password@localhost:3306/wordcracker_blog

# ─────────────────────────────────────────────────────────────────────────
# 인증 설정 (Manus OAuth)
# ─────────────────────────────────────────────────────────────────────────
# JWT 토큰 서명 비밀키 (최소 32자 이상 권장)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Manus OAuth 애플리케이션 ID
VITE_APP_ID=your-manus-app-id

# Manus OAuth 서버 URL
OAUTH_SERVER_URL=https://api.manus.im

# Manus OAuth 포털 URL (프론트엔드)
VITE_OAUTH_PORTAL_URL=https://manus.im/oauth

# 사이트 소유자 정보
OWNER_NAME=Your Name
OWNER_OPEN_ID=your-open-id

# ─────────────────────────────────────────────────────────────────────────
# Manus 빌트인 API 설정
# ─────────────────────────────────────────────────────────────────────────
# 서버사이드 API 엔드포인트
BUILT_IN_FORGE_API_URL=https://api.manus.im/v1

# 서버사이드 API 키
BUILT_IN_FORGE_API_KEY=your-server-api-key

# 프론트엔드 API 키
VITE_FRONTEND_FORGE_API_KEY=your-frontend-api-key

# 프론트엔드 API 엔드포인트
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im/v1

# ─────────────────────────────────────────────────────────────────────────
# 외부 서비스 통합
# ─────────────────────────────────────────────────────────────────────────
# Google Gemini API 키 (AI 기능용)
GEMINI_API_KEY=your-gemini-api-key

# Google API 키 (Maps, Places 등)
GOOGLE_API_KEY=your-google-api-key

# Google Indexing Service 계정 키 (JSON 형식, 개행 제거 후 저장)
GOOGLE_INDEXING_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Kakao JavaScript 키 (지도, 소셜 로그인 등)
VITE_KAKAO_JS_KEY=your-kakao-js-key

# ─────────────────────────────────────────────────────────────────────────
# 분석 및 모니터링
# ─────────────────────────────────────────────────────────────────────────
# 방문 통계 분석 엔드포인트
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com

# 분석 웹사이트 ID
VITE_ANALYTICS_WEBSITE_ID=your-website-id

# ─────────────────────────────────────────────────────────────────────────
# 애플리케이션 설정
# ─────────────────────────────────────────────────────────────────────────
# 사이트 제목 (브라우저 탭, 메타 태그)
VITE_APP_TITLE=워드크래커 블로그

# 사이트 로고 URL
VITE_APP_LOGO=https://example.com/logo.png

# ─────────────────────────────────────────────────────────────────────────
# 개발 환경 설정
# ─────────────────────────────────────────────────────────────────────────
# Node 환경 (development, production)
NODE_ENV=production

# 개발 서버 포트 (개발 시에만 사용)
PORT=3000

# ═══════════════════════════════════════════════════════════════════════════
# 설정 방법
# ═══════════════════════════════════════════════════════════════════════════
#
# 1. 이 파일을 복사하여 .env.local 또는 .env 파일 생성
#    cp .env.example .env.local
#
# 2. 각 항목의 값을 실제 값으로 변경
#
# 3. 프로덕션 배포 시:
#    - 환경변수를 시스템 환경에 직접 설정 (Docker, Kubernetes, 클라우드 플랫폼 등)
#    - .env 파일은 버전 관리에서 제외 (.gitignore에 이미 등록됨)
#
# ═══════════════════════════════════════════════════════════════════════════
