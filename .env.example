# Copy this file to .env.local for local development. Never commit real values.
# Variables prefixed with VITE_ are embedded in browser assets and are public.

# Database
DATABASE_PROVIDER=node
DATABASE_URL=mysql://user:password@localhost:3306/vibecraft
# Worker only: set DATABASE_PROVIDER=hyperdrive and provide the HYPERDRIVE binding.
# DB_HEALTH_TOKEN belongs in `.dev.vars` or Workers Secrets, never in this file.

# Authentication (existing Manus OAuth; retained during Phase 1)
JWT_SECRET=replace-with-a-random-value-at-least-32-characters
VITE_APP_ID=your-manus-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im/oauth
OWNER_NAME=Your Name
OWNER_OPEN_ID=your-manus-open-id

# Storage and Manus built-in APIs (retained during Phase 1)
# Use `forge` for the existing behavior. Use `r2` only in a Worker runtime where
# the R2_BUCKET binding is available.
STORAGE_PROVIDER=forge
BUILT_IN_FORGE_API_URL=https://api.manus.im/v1
BUILT_IN_FORGE_API_KEY=your-server-side-forge-api-key
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im/v1
VITE_FRONTEND_FORGE_API_KEY=your-public-frontend-forge-api-key

# AI and external APIs
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-google-api-key
# Store the complete service-account JSON as one secret value in the runtime.
GOOGLE_INDEXING_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"example"}
VITE_KAKAO_JS_KEY=your-public-kakao-javascript-key

# Analytics
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
VITE_ANALYTICS_WEBSITE_ID=your-public-website-id

# Application runtime
VITE_APP_TITLE=Vibecraft
VITE_APP_LOGO=https://example.com/logo.png
NODE_ENV=production
PORT=3000
# Usually injected by the build pipeline.
BUILD_HASH=local

# Cloudflare migration notes
# Do not put Cloudflare API tokens, account IDs, Hyperdrive IDs, or R2 credentials
# in this file. ASSETS, HYPERDRIVE, and R2_BUCKET are Wrangler bindings defined
# in wrangler.jsonc. Runtime secrets belong in `.dev.vars` locally and in
# Cloudflare Workers secrets for preview/production.
#
# Future authentication/provider secrets (not used in Phase 1):
# OAUTH_CLIENT_ID=replace-in-workers-secrets
# OAUTH_CLIENT_SECRET=replace-in-workers-secrets
# OAUTH_ISSUER_URL=https://issuer.example.com
# OPENAI_API_KEY=replace-in-workers-secrets
